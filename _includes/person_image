<div class="flex-item person" title="{{ include.title | default: include.caption }}">
        {% if include.link and include.link != "" %}
        <a href="{{ include.link }}">
        {% else %}
        <div class="person-link-disabled" aria-disabled="true">
        {% endif %}
                <img src="{{ site.baseurl }}/images/people/{{ include.image }}" alt="{{ include.caption }}" loading="lazy" decoding="async" />
                <p>{{ include.caption }}</p>
        {% if include.link and include.link != "" %}
        </a>
        {% else %}
        </div>
        {% endif %}
</div>
